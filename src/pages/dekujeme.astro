---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---
<BaseLayout title="Děkujeme – Elektroservis Žemlička" description="Vaše poptávka byla úspěšně odeslána.">
  <Header />
  <main class="section flex min-h-[60vh] flex-col items-center justify-center">
    <div class="card flex max-w-md flex-col items-center gap-6 text-center">
      <!-- success icon -->
      <div class="flex h-20 w-20 items-center justify-center rounded-full bg-honey/20">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="#f3aa1f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          class="h-10 w-10">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </div>

      <div class="grid gap-2">
        <h1 class="text-3xl font-black tracking-tight md:text-4xl">Poptávka odeslána!</h1>
        <p class="text-black/60">
          Děkujeme za váš zájem. Ozveme se vám co nejdříve,<br class="hidden sm:block" />
          obvykle do&nbsp;24&nbsp;hodin.
        </p>
      </div>

      <div class="w-full rounded-2xl bg-cream px-6 py-4 text-sm">
        <p class="text-black/50">Potřebujete pomoc ihned?</p>
        <a href="tel:+420606103986" class="mt-1 block text-xl font-black tracking-tight text-ink hover:text-honey transition-colors">
          +420 606 103 986
        </a>
      </div>

      <a href="/" class="btn btn-primary w-full">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="mr-2 h-4 w-4">
          <path d="M19 12H5M12 5l-7 7 7 7" />
        </svg>
        Zpět na hlavní stránku
      </a>
    </div>
  </main>
  <footer class="bg-ink px-5 py-10 text-center text-sm text-white/70">
    © {new Date().getFullYear()} Elektroservis Žemlička · elektro-zemlicka.cz
  </footer>
</BaseLayout>
