---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout>
  <Header />
  <Hero />

  <main>
  <section id="sluzby" class="section">
    <span class="badge">Služby</span>
    <h2 class="mt-5 text-4xl font-black tracking-tight md:text-5xl">Co nabízíme</h2>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-black/65">
      Zajišťujeme opravy domácích spotřebičů, prodej bílé techniky a drobné elektroinstalační práce v domácnostech.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {[
        ['Opravy spotřebičů', 'Pračky, sušičky, myčky, trouby, varné desky, lednice a mrazáky.'],
        ['Diagnostika závad', 'Zjištění příčiny poruchy, doporučení opravy a předběžné nacenění dalšího postupu.'],
        ['Prodej bílé techniky', 'Pomůžeme s výběrem vhodného spotřebiče podle potřeb domácnosti a možností instalace.'],
        ['Drobné elektroinstalace', 'Výměna zásuvek, vypínačů, svítidel, žárovek a další menší elektro práce.'],
        ['Nové zásuvky a kabeláž', 'Doplnění nové zásuvky, natažení kabelu nebo úprava jednoduchých rozvodů.'],
        ['Pravidelná údržba', 'Kontrola, čištění a údržba spotřebičů pro delší životnost a bezpečný provoz.']
      ].map(([title, text]) => (
        <div class="card">
          <h3 class="text-xl font-extrabold">{title}</h3>
          <p class="mt-3 text-black/65">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="proc" class="bg-white">
    <div class="section grid gap-10 md:grid-cols-2">
      <div>
        <span class="badge bg-sun/40">Proč Elektroservis Žemlička</span>
        <h2 class="mt-5 text-4xl font-black tracking-tight md:text-5xl">Férově, srozumitelně a bez skrytých překvapení.</h2>
      </div>
      <div class="grid gap-4">
        <p class="rounded-3xl bg-cream p-6 text-lg leading-8">Nejdříve zjistíme skutečnou příčinu závady. Potom vysvětlíme možnosti opravy, cenu a dostupnost dílů.</p>
        <p class="rounded-3xl bg-sun/40 p-6 text-lg leading-8">Pomůžeme nejen s opravou spotřebiče, ale také s drobnými elektro pracemi a výběrem vhodné bílé techniky do domácnosti.</p>
      </div>
    </div>
  </section>

    <section id="cenik" class="section">
      <span class="badge">Orientační ceník</span>

      <div class="mt-8 overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-black/5">
        <div class="grid grid-cols-2 border-b border-black/5 p-5 font-bold">
          <span>Služba</span>
          <span>Cena</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Diagnostika závady</span>
          <span>450 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Výměna vnějších dílů bez rozebrání spotřebiče</span>
          <span>640 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Dílenská oprava řídící elektroniky</span>
          <span>760 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Oprava vnitřních částí spotřebiče</span>
          <span>1 040 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Složitá oprava (ložiska, buben, sušičky, kávovary)</span>
          <span>2 250 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Demontáž / montáž vestavných spotřebičů</span>
          <span>200 Kč</span>
        </div>

        <div class="grid grid-cols-2 border-b border-black/5 p-5">
          <span>Spotřební materiál, energie a voda</span>
          <span>180 Kč</span>
        </div>

        <div class="grid grid-cols-2 p-5">
          <span>Doprava / výjezd</span>
          <span>dle vzdálenosti</span>
        </div>
      </div>

      <p class="mt-4 text-sm text-black/60">
        Ceny náhradních dílů nejsou zahrnuty v ceně opravy. Přesná cena bude sdělena po diagnostice závady.
      </p>
    </section>

    <section id="kontakt" class="section grid gap-10 md:grid-cols-[.9fr_1.1fr]">
      <div>
        <span class="badge">Kontakt</span>
        <h2 class="mt-5 text-4xl font-black tracking-tight md:text-5xl">Napište nebo zavolejte.</h2>
        <div class="mt-8 space-y-3 text-lg">
          <p><strong>Telefon:</strong> <a href="tel:+420606103986" class="underline">+420 606 103 986</a></p>
          <p><strong>Email:</strong> <a href="mailto:milan_zemlicka@email.cz" class="underline">milan_zemlicka@email.cz</a></p>
          <p>Působíme v Ostravě, Orlové, Karviné, Stonavě, Českém Těšíně, Třinci a okolí.</p>
        </div>
      </div>
      <ContactForm />
    </section>
  </main>

  <footer class="bg-ink px-5 py-10 text-center text-sm text-white/70">
    © {new Date().getFullYear()} Elektroservis Žemlička · elektro-zemlicka.cz
  </footer>
</BaseLayout>
